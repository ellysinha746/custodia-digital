DATABASE_URL=postgresql://custodia_user:custodia_pass@db:5432/custodia_db
SECRET_KEY=cambia-esto-por-un-texto-largo-y-secreto
# Correo de alertas (Sprint 4). Si SMTP_HOST queda vacío, el correo se imprime en la consola.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
ALERTAS_EMAIL_ADMIN=
ESCANEO_INTEGRIDAD_MIN=5
# Sprint 6 (historia 26): recordatorio de plazos por vencer
RECORDATORIO_DIAS_ANTES=2
RECORDATORIOS_CADA_MIN=60

# Sprint 6 (historia 22): almacenamiento. Con docker-compose ya se configura MinIO
# (ver docker-compose.yml); estas variables solo hacen falta fuera de Docker.
# STORAGE_BACKEND=local
# S3_ENDPOINT_URL=http://localhost:9000
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_BUCKET=custodia-evidencias